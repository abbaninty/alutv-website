<!DOCTYPE html>
<html lang="en">
<head>
<meta property="og:image" content="https://firebasestorage.googleapis.com/v0/b/alu-tv-15c8a.firebasestorage.app/o/alutv_logo.png?alt=media">
<meta property="og:title" content="Alu Tv">
<meta property="og:description" content="Alu Tv - Exclusive Investigative Documentaries and News">
<meta property="og:type" content="website">
<meta property="og:url" content="https://alutv.com">
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Alu Tv</title>
<script crossorigin="anonymous" src="https://www.gstatic.com/firebasejs/10.9.0/firebase-app-compat.js">
function renderDefaultFeed(allArticles) {
  const activeNav = document.querySelector('.nav-link.border-white');
  const currentCategory = activeNav ? activeNav.dataset.target : 'Home';
  renderArticles(currentCategory);
}

function renderNewsItem(article) {
  const artDate = formatNewsDate(article.id);
  const img = article.image ? `<img src="${article.image}" alt="${article.title}" class="w-[100px] h-[75px] object-cover rounded-sm group-hover:opacity-90 transition-opacity flex-shrink-0" />` : `<div class="w-[100px] h-[75px] bg-gray-200 rounded-sm flex-shrink-0"></div>`;
  return `<article onclick="openArticle('${article.id}')" class="flex items-center gap-4 border-b border-gray-200 py-4 cursor-pointer group last:border-0">
    ${img}
    <div class="flex flex-col justify-center flex-1">
       <span class="text-[10px] text-news-purple font-bold uppercase tracking-widest mb-1">${article.category || 'News'}</span>
       <h3 class="font-bold text-base leading-tight mb-1 group-hover:text-purple-700 transition-colors line-clamp-2 text-gray-900">${article.title}</h3>
       <span class="text-[11px] text-gray-500 font-medium">${artDate}</span>
    </div>
  </article>`;
}

function executeInstantLiveSearch(searchQuery, allArticles, outputContainer) {
  const cleanQuery = searchQuery.trim().toLowerCase();
  outputContainer.innerHTML = ''; // Clear prior loop outputs
  if (cleanQuery === '') {
    // If input is empty, render default full feed sequence
    renderDefaultFeed(allArticles);
    return;
  }
  
  const filteredArticles = allArticles.filter(article => 
    (article.title && article.title.toLowerCase().includes(cleanQuery)) ||
    (article.category && article.category.toLowerCase().includes(cleanQuery)) ||
    (article.content && article.content.toLowerCase().includes(cleanQuery)) ||
    (article.summary && article.summary.toLowerCase().includes(cleanQuery))
  );
  
  if (filteredArticles.length === 0) {
    outputContainer.innerHTML = `
      <div class="no-results" style="padding: 30px; text-align: center; color: #888;">
        <p>No matching news items found for "${searchQuery}". Try alternative terms.</p>
      </div>
    `;
    return;
  }
  
  outputContainer.innerHTML = `<div class="mb-6"><h2 class="text-xl md:text-2xl font-black text-gray-900 border-l-4 border-news-purple pl-3 tracking-tighter uppercase">Search Results for "${searchQuery}"</h2></div><div class="flex flex-col">`;
  // Render search results matching parameters dynamically
  filteredArticles.forEach(article => {
    outputContainer.innerHTML += renderNewsItem(article); 
  });
  outputContainer.innerHTML += `</div>`;
}

document.addEventListener('DOMContentLoaded', () => {
   const searchInput = document.getElementById('liveSearchInput');
   if (searchInput) {
       searchInput.addEventListener('input', (e) => {
           const container = document.getElementById('main-content');
           if (container) {
               // Make sure we only show search in the grid
               document.getElementById('homepage-grid').classList.remove('hidden');
               document.getElementById('single-article-view').classList.add('hidden');
               document.getElementById('home-bottom-content').classList.add('hidden');
               
               executeInstantLiveSearch(e.target.value, articles.filter(a => a.status === 'Publish'), container);
           }
       });
   }
});

</script>
<script crossorigin="anonymous" src="https://www.gstatic.com/firebasejs/10.9.0/firebase-database-compat.js"></script>
<script crossorigin="anonymous" src="https://www.gstatic.com/firebasejs/10.9.0/firebase-storage-compat.js"></script>
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
body { 
font-family: 'Inter', sans-serif; 
background-color: #f3f4f6; 
color: #111827; 
}
.bg-news-purple { background-color: #3B0764 !important; }
.text-news-purple { color: #3B0764 !important; }
.border-news-purple { border-color: #3B0764 !important; }
.bg-news-dark { background-color: #212121; }
/* Hide scrollbar for clean UI */
.no-scrollbar::-webkit-scrollbar { display: none; }
.no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }


.breaking-news-ticker {
  display: block;
  width: 100%;
  background: #111;
  color: #fff;
  height: 40px;
  overflow: hidden;
  font-family: Arial, sans-serif;
}
.ticker-title {
  display: inline-block;
  background: #7b1fa2;
  color: white;
  padding: 10px 15px;
  font-weight: bold;
  font-size: 13px;
  float: left;
  z-index: 10;
}
.ticker-content-wrap {
  overflow: hidden;
  padding: 10px 0;
}
.ticker-content {
  display: inline-block;
  white-space: nowrap;
  padding-left: 100%;
  animation: ticker-move 90s linear infinite;
}
@keyframes ticker-move {
  0% { transform: translate3d(0, 0, 0); }
  100% { transform: translate3d(-100%, 0, 0); }
}
.ticker-content span {
  display: inline-block;
  padding-right: 50px;
  font-size: 14px;
  color: #ffffff;
  font-weight: bold;
}

.premium-showcase-section {
  background: #0a0a0a;
  color: #ffffff;
  padding: 30px 15px;
  border-radius: 12px;
  margin: 20px 0;
}
.section-header h2 {
  color: #7b1fa2;
  font-size: 22px;
  margin-bottom: 5px;
  letter-spacing: 1px;
}
.section-header p {
  color: #aaa;
  font-size: 13px;
  margin-bottom: 20px;
}
.cinematic-card {
  background: #161616;
  border-radius: 8px;
  overflow: hidden;
  border: 1px solid #222;
}
.video-container video, .video-container iframe {
  width: 100%;
  display: block;
}
.cinematic-meta {
  padding: 15px;
}
.cinematic-meta .badge {
  background: #7b1fa2;
  font-size: 10px;
  font-weight: bold;
  padding: 3px 8px;
  border-radius: 3px;
}
.cinematic-meta h3 {
  margin: 10px 0 5px 0;
  font-size: 17px;
  line-height: 1.4;
}
.cinematic-meta .pub-date {
  color: #666;
  font-size: 12px;
}

/* Global English Theme Mappings */
:root {
  --bg-color: #ffffff;
  --text-color: #111111;
  --card-bg: #f9f9f9;
  --border-color: #eeeeee;
}
[data-theme="dark"] {
  --bg-color: #121212;
  --text-color: #e0e0e0;
  --card-bg: #1e1e1e;
  --border-color: #333333;
}
body {
  background-color: var(--bg-color) !important;
  color: var(--text-color) !important;
  transition: background 0.3s ease, color 0.3s ease;
}
/* Ensure tailwind doesn't override our text colors in dark mode where it matters */
[data-theme="dark"] .bg-gray-100 { background-color: var(--bg-color) !important; }
[data-theme="dark"] .bg-white { background-color: var(--card-bg) !important; }
[data-theme="dark"] .text-gray-900, [data-theme="dark"] .text-gray-800, [data-theme="dark"] .text-gray-600, [data-theme="dark"] .text-gray-500 { color: var(--text-color) !important; }
[data-theme="dark"] .border-gray-200 { border-color: var(--border-color) !important; }

.theme-toggle-btn {
  background: transparent;
  color: white;
  border: 1px solid rgba(255,255,255,0.5);
  padding: 4px 10px;
  border-radius: 4px;
  font-size: 12px;
  font-weight: bold;
  cursor: pointer;
  transition: background 0.3s;
  white-space: nowrap;
}
.theme-toggle-btn:hover {
  background: rgba(255,255,255,0.1);
}
</style>
</head>
<body class="flex flex-col min-h-screen w-full overflow-x-hidden bg-gray-100">
<header class="bg-news-purple text-white flex flex-col lg:flex-row lg:items-center px-4 lg:px-6 py-3 lg:py-0 lg:h-16 shadow-lg shrink-0 gap-4 lg:gap-0 z-20">
<div class="flex items-center justify-between w-full lg:w-auto lg:mr-8">
<div class="flex items-center gap-3">
<a href="#" onclick="navigate('Home', event)" class="font-black text-2xl lg:text-3xl tracking-tighter uppercase flex items-center">
ALU TV
</a>
</div>
<div class="flex items-center gap-3 lg:hidden">
<a href="#" target="_blank" id="header-social-fb" class="hidden text-white hover:text-gray-300 transition-colors">
<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/></svg>
</a>
<a href="#" target="_blank" id="header-social-yt" class="hidden text-white hover:text-gray-300 transition-colors">
<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>
</a>
<div class="flex items-center space-x-1 bg-purple-800 px-2 py-1 rounded text-[10px] font-bold">
<span class="w-1.5 h-1.5 bg-white rounded-full animate-pulse"></span>
<span>LIVE</span>
</div>
</div>
</div>
<div class="flex items-center w-full lg:w-auto overflow-x-auto no-scrollbar pb-1 lg:pb-0">
<nav class="flex overflow-x-auto no-scrollbar py-3 lg:py-0 px-4 lg:px-6 gap-6 text-sm font-bold tracking-wider uppercase text-white/90">
<a href="#" onclick="navigate('Home', event)" class="nav-link hover:opacity-80 transition-opacity whitespace-nowrap border-b-4 border-white lg:border-white pb-1 lg:py-5" data-target="Home">Home</a>
<a href="#" onclick="navigate('Politics', event)" class="nav-link hover:opacity-80 transition-opacity whitespace-nowrap lg:py-5 lg:border-b-4 border-transparent lg:border-transparent" data-target="Politics">Politics</a>
<a href="#" onclick="navigate('Business', event)" class="nav-link hover:opacity-80 transition-opacity whitespace-nowrap lg:py-5 lg:border-b-4 border-transparent lg:border-transparent" data-target="Business">Business</a>
<a href="#" onclick="navigate('Agriculture', event)" class="nav-link hover:opacity-80 transition-opacity whitespace-nowrap lg:py-5 lg:border-b-4 border-transparent lg:border-transparent" data-target="Agriculture">Agriculture</a>
<a href="#" onclick="navigate('Security', event)" class="nav-link hover:opacity-80 transition-opacity whitespace-nowrap lg:py-5 lg:border-b-4 border-transparent lg:border-transparent" data-target="Security">Security</a>
<a href="#" onclick="navigate('Lifestyle', event)" class="nav-link hover:opacity-80 transition-opacity whitespace-nowrap lg:py-5 lg:border-b-4 border-transparent lg:border-transparent" data-target="Lifestyle">Lifestyle</a>
<a href="#" onclick="navigate('Sports', event)" class="nav-link hover:opacity-80 transition-opacity whitespace-nowrap lg:py-5 lg:border-b-4 border-transparent lg:border-transparent" data-target="Sports">Sports</a>
<a href="#" onclick="navigate('Social', event)" class="nav-link hover:opacity-80 transition-opacity whitespace-nowrap lg:py-5 lg:border-b-4 border-transparent lg:border-transparent" data-target="Social">Social</a>
<a href="#" onclick="navigate('Entertainment', event)" class="nav-link hover:opacity-80 transition-opacity whitespace-nowrap lg:py-5 lg:border-b-4 border-transparent lg:border-transparent" data-target="Entertainment">Entertainment</a>
<a href="#" onclick="navigate('History', event)" class="nav-link hover:opacity-80 transition-opacity whitespace-nowrap lg:py-5 lg:border-b-4 border-transparent lg:border-transparent" data-target="History">History</a>
<a href="#" onclick="navigate('Law', event)" class="nav-link hover:opacity-80 transition-opacity whitespace-nowrap lg:py-5 lg:border-b-4 border-transparent lg:border-transparent" data-target="Law">Law</a>
<input type="text" id="liveSearchInput" placeholder="Search news..." class="bg-purple-800 text-white placeholder-purple-300 border border-purple-600 rounded px-3 py-1 text-xs focus:outline-none focus:border-white transition-colors ml-4" />
<button id="themeToggleBtn" class="theme-toggle-btn ml-4" aria-label="Toggle Theme Mode">🌓 Switch Theme</button>
</nav>
<div class="hidden lg:flex items-center gap-4 ml-6 pl-6 border-l border-white/20 shrink-0">
<a href="#" target="_blank" id="header-desktop-social-fb" class="hidden text-white hover:text-gray-300 transition-colors">
<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/></svg>
</a>
<a href="#" target="_blank" id="header-desktop-social-yt" class="hidden text-white hover:text-gray-300 transition-colors">
<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>
</a>
</div>
</div>
</header>
<a href="#" target="_blank" id="public-office-flyer-link" class="hidden w-full block bg-gray-100 border-b border-gray-300">
<img id="public-office-flyer-image" src="" alt="Office Flyer" class="w-full h-auto object-contain max-h-[300px]">
</a>

<div class="breaking-news-ticker">
  <div class="ticker-title">BREAKING NEWS</div>
  <div class="ticker-content-wrap">
    <div class="ticker-content" id="breakingTicker">
      <!-- Injected Dynamically via JS -->
      <span>• Loading critical updates from Alu TV newsroom... </span>
    </div>
  </div>
</div>

<main class="flex-1 w-full relative max-w-[1400px] mx-auto bg-gray-100">
<div id="homepage-grid" class="flex flex-col lg:flex-row p-4 gap-4 w-full">
<section class="w-full lg:w-2/3 flex flex-col gap-4 pb-10" id="main-content">
</section>
<aside id="main-sidebar" class="w-full lg:w-1/3 flex flex-col gap-4 pb-10">
    <a href="https://example.com" target="_blank" id="dynamic-ad-link" class="bg-gray-200 border-dashed border-2 border-gray-300 flex flex-col items-center justify-center p-2 relative flex-shrink-0 cursor-pointer hover:bg-gray-300 transition-colors h-32 w-full block">
      <span class="absolute top-1 left-1 text-[8px] font-bold text-gray-400 uppercase tracking-widest z-10">Advertisement</span>
      <div class="text-center w-full h-full flex flex-col items-center justify-center">
        <img id="dynamic-ad-image" src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?auto=format&fit=crop&q=80&w=300&h=250" class="absolute inset-0 w-full h-full object-cover rounded-sm" alt="Ad Background">
        <div class="relative z-20">
          <div id="dynamic-ad-title" class="text-sm font-black text-gray-800 uppercase bg-white/80 px-2 py-1 rounded">Premium Cloud Solutions</div>
          <button class="mt-2 bg-blue-600 hover:bg-blue-700 transition-colors text-white text-[10px] px-3 py-1 font-bold uppercase tracking-wider rounded shadow">Click To Learn More</button>
        </div>
      </div>
    </a>
  </aside>
</div> 
<div id="home-bottom-content" class="w-full px-4 pb-10"></div>
<div id="single-article-view" class="hidden p-4 md:p-6 w-full max-w-4xl mx-auto">
</div>
</main>
<div id="admin-dashboard" class="bg-gray-200 border-t-4 border-news-dark shrink-0 flex-col mt-auto w-full hidden">
<div class="bg-news-dark text-white px-6 py-4 flex justify-between items-center shrink-0">
<div>
<h1 class="text-xl font-black uppercase tracking-widest">Alu Tv Admin Dashboard</h1>
<div id="admin-user-info" class="text-xs text-gray-400 mt-1">Logged in as: <span id="admin-role-display" class="font-bold text-white uppercase"></span></div>
</div>
<div class="flex items-center gap-4">
<span class="text-xs font-bold uppercase tracking-wider text-gray-400 hidden md:inline">Live Preview Mode</span>
<button onclick="logoutAdmin()" class="bg-news-purple hover:bg-purple-700 text-white text-xs px-3 py-1 rounded font-bold uppercase tracking-wider transition-colors">Logout</button>
</div>
</div>
<div class="p-4 md:p-8">
<div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8">
<div class="bg-white p-6 rounded shadow-sm border border-gray-200 h-fit">
<h2 class="font-bold text-lg mb-4 border-b pb-2" id="admin-art-form-title">Add New Article</h2>
<form onsubmit="handleArticleSubmit(event)" class="space-y-4">
<input type="hidden" id="admin-art-id" value="">
<div class="grid grid-cols-2 gap-4">
  <div>
    <label class="block text-xs font-bold text-gray-700 mb-1">Post Type</label>
    <select id="admin-art-type" onchange="togglePostType()" class="w-full border border-gray-300 rounded p-2 text-sm focus:outline-news-purple">
      <option value="article">Article</option>
      <option value="video">Video</option>
      <option value="audio">Audio</option>
    </select>
  </div>
  <div>
    <label class="block text-xs font-bold text-gray-700 mb-1">Status</label>
    <select id="admin-art-status" required class="w-full border border-gray-300 rounded p-2 text-sm focus:outline-news-purple">
      <option value="Publish">Publish</option>
      <option value="Draft">Draft</option>
    </select>
  </div>
</div>
<div>
  <label class="block text-xs font-bold text-gray-700 mb-1">Category</label>
  <select id="admin-art-category" required class="w-full border border-gray-300 rounded p-2 text-sm focus:outline-news-purple">
    <option value="Politics">Politics</option>
    <option value="Business">Business</option>
    <option value="Agriculture">Agriculture</option>
    <option value="Security">Security</option>
    <option value="Lifestyle">Lifestyle</option>
    <option value="Sports">Sports</option>
    <option value="Social">Social</option>
    <option value="Entertainment">Entertainment</option>
    <option value="History">History</option>
    <option value="Law">Law</option>
</select>
</div>
<div>
  <label class="block text-xs font-bold text-gray-700 mb-1">Title</label>
  <input type="text" id="admin-art-title" required class="w-full border border-gray-300 rounded p-2 text-sm focus:outline-news-purple">
</div>
<div id="admin-field-subtitle">
  <label class="block text-xs font-bold text-gray-700 mb-1">Subtitle</label>
  <input type="text" id="admin-art-subtitle" class="w-full border border-gray-300 rounded p-2 text-sm focus:outline-news-purple">
</div>
<div id="admin-field-content">
  <label class="block text-xs font-bold text-gray-700 mb-1">Content</label>
  <div class="border border-gray-300 rounded overflow-hidden">
    <div class="bg-gray-100 border-b border-gray-300 px-2 py-1 flex gap-2 text-sm items-center">
      <button type="button" onclick="document.execCommand('bold',false,null)" class="px-2 font-bold hover:bg-gray-200 rounded">B</button>
      <button type="button" onclick="document.execCommand('italic',false,null)" class="px-2 italic hover:bg-gray-200 rounded">I</button>
      <button type="button" onclick="document.execCommand('underline',false,null)" class="px-2 underline hover:bg-gray-200 rounded">U</button>
      <span class="w-px h-4 bg-gray-300 mx-1"></span>
      <select onchange="document.execCommand('formatBlock',false,this.value); this.selectedIndex=0;" class="text-xs border border-gray-300 rounded bg-white px-1">
        <option value="">Heading</option>
        <option value="H1">H1</option>
        <option value="H2">H2</option>
        <option value="H3">H3</option>
        <option value="P">Paragraph</option>
      </select>
    </div>
    <div id="admin-art-content" contenteditable="true" class="p-3 min-h-[120px] max-h-[300px] overflow-y-auto text-sm focus:outline-none focus:bg-gray-50"></div>
  </div>
</div>
<div id="admin-field-top-image">
  <label class="block text-xs font-bold text-gray-700 mb-1">Top Cover Image (Upload)</label>
  <input type="file" id="admin-art-image" accept="image/png, image/jpeg, image/*" class="w-full border border-gray-300 rounded p-2 text-sm focus:outline-news-purple bg-white">
</div>
<div id="admin-field-body-image">
  <label class="block text-xs font-bold text-gray-700 mb-1">Inline Body Image (Upload)</label>
  <input type="file" id="admin-art-body-image" accept="image/png, image/jpeg, image/*" class="w-full border border-gray-300 rounded p-2 text-sm focus:outline-news-purple bg-white">
</div>
<div id="admin-field-video" class="hidden">
  <label class="block text-xs font-bold text-gray-700 mb-1">Video URL (MP4)</label>
  <input type="text" id="adminVideoUrl" placeholder="Paste Direct Video URL (MP4)..." class="w-full border border-gray-300 rounded p-2 text-sm focus:outline-news-purple">
</div>
<div id="admin-field-audio" class="hidden">
  <label class="block text-xs font-bold text-gray-700 mb-1">Audio URL (MP3)</label>
  <input type="text" id="adminAudioUrl" placeholder="Paste Direct Audio URL (MP3)..." class="w-full border border-gray-300 rounded p-2 text-sm focus:outline-news-purple">
</div>
<div class="flex gap-2">
  <button type="submit" id="admin-art-submit-btn" class="bg-news-purple text-white px-4 py-2 rounded text-xs font-bold uppercase tracking-wider flex-1 hover:bg-purple-800 transition-colors">Publish Post</button>
  <button type="button" onclick="resetArticleForm()" id="admin-art-cancel-btn" class="hidden bg-gray-500 text-white px-4 py-2 rounded text-xs font-bold uppercase tracking-wider hover:bg-gray-700 transition-colors">Cancel</button>
</div>
</form>
</div>
<div id="admin-media-config" class="space-y-8">
<div class="bg-white p-6 rounded shadow-sm border border-gray-200">
<h2 class="font-bold text-lg mb-4 border-b pb-2">Social Media Links</h2>
<form onsubmit="handleSocialLinksUpdate(event)" class="space-y-4">
<div>
<label class="block text-xs font-bold text-gray-700 mb-1">Facebook Page URL</label>
<input type="url" id="admin-facebook-url" placeholder="https://facebook.com/..." class="w-full border border-gray-300 rounded p-2 text-sm focus:outline-news-purple">
</div>
<div>
