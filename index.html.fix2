<script>
// 1. Firebase Setup & Database Connection
const firebaseConfig = {
apiKey: "AIzaSyA1Ee4QugQJQ_FS-lMkjSKkRNC_2Z5wpyI",
authDomain: "alu-tv-15c8a.firebaseapp.com",
databaseURL: "https://alu-tv-15c8a-default-rtdb.firebaseio.com",
projectId: "alu-tv-15c8a",
storageBucket: "alu-tv-15c8a.firebasestorage.app",
messagingSenderId: "795605070409",
appId: "1:795605070409:web:56bf4d9c89c9d12fe18598",
measurementId: "G-PQY3ZB45CS"
};
let articles = [];
let db = null;
let currentUserRole = null; // 'superadmin', 'admin', 'editor', 'reporter'
firebase.initializeApp(firebaseConfig);
db = firebase.database();

// Real-time listener for Settings (Ticker)
db.ref('settings/ticker').on('value', (snapshot) => {
    const customTicker = snapshot.val();
    const tickerElement = document.getElementById('breakingTicker');
    if (tickerElement && customTicker) {
        // Find existing automated items if we want to combine, or just overwrite. Overwriting might be best if it's "live content"
        // But maybe they want it prepended. Let's prepend it to the automated ones.
        
        // Actually, we'll store customTicker globally and updateTicker will combine them.
        window.customTickerText = customTicker;
        const adminInput = document.getElementById("admin-ticker-text");
        if (adminInput) adminInput.value = customTicker;
        if (typeof articles !== 'undefined') {
           updateTicker(articles);
        }
    } else if (tickerElement && !customTicker) {
        window.customTickerText = '';
        if (typeof articles !== 'undefined') {
           updateTicker(articles);
        }
    }
});

// Real-time listener for Originals
let originals = [];
db.ref('originals').on('value', (snapshot) => {
    const data = snapshot.val();
    originals = data ? Object.values(data) : [];
    originals.sort((a, b) => b.id - a.id); // Sort by newest first
    renderOriginals();
});

function renderOriginals() {
    const grid = document.getElementById('documentaryGrid');
    if (!grid) return;
    
    if (originals.length === 0) {
       return;
    }
    
    grid.innerHTML = originals.map(orig => {
       const dateStr = new Date(orig.id).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
       const poster = orig.posterUrl || 'documentary-cover.jpg';
       const embedUrl = getYouTubeEmbedUrl(orig.videoUrl);
       
       let playerHtml = '';
       if (embedUrl !== orig.videoUrl) {
           playerHtml = `<iframe src="${embedUrl}" frameborder="0" allowfullscreen class="w-full aspect-video border-0"></iframe>`;
       } else {
           playerHtml = `
              <video controls preload="metadata" poster="\${poster}" class="w-full aspect-video object-cover bg-black block">
                <source src="\${orig.videoUrl}" type="video/mp4">
                Your browser does not support the video tag.
              </video>
           `;
       }

       return `
          <div class="cinematic-card">
            <div class="video-container">
              \${playerHtml}
            </div>
            <div class="cinematic-meta">
              <span class="badge">\${orig.badge || 'ORIGINAL'}</span>
              <h3>\${orig.title}</h3>
              <p class="pub-date">Published: \${dateStr}</p>
            </div>
          </div>
       `;
    }).join('');
}

// Real-time listener for articles
let isInitialLoad = true;
db.ref('articles').on('value', (snapshot) => {
const data = snapshot.val();
articles = data ? Object.values(data) : [];
// Sort by descending ID (which acts as a timestamp for new posts)
articles.sort((a, b) => b.id - a.id);
renderAdminTable();
if (window.togglePostType) window.togglePostType();
if (isInitialLoad && window.location.hash.startsWith('#post-')) {
const postId = window.location.hash.replace('#post-', '');
openArticle(postId);
isInitialLoad = false;
} else {
const activeNav = document.querySelector('.nav-link.border-white');
const currentCategory = activeNav ? activeNav.dataset.target : 'Home';
renderArticles(currentCategory);
// Update open article if one is currently being viewed
if (!document.getElementById('single-article-view').classList.contains('hidden') && window.location.hash.startsWith('#post-')) {
const postId = window.location.hash.replace('#post-', '');
openArticle(postId);
}
isInitialLoad = false;
}
}, (err) => {
console.warn("Database error:", err);
});
let allUsers = [];
db.ref('users').on('value', (snapshot) => {
const data = snapshot.val();
allUsers = data ? Object.entries(data).map(([id, val]) => ({ id, ...val })) : [];
if (currentUserRole === 'superadmin') {
renderUsersTable();
}
});
// Real-time listeners for Media & Ads settings
db.ref('settings/social').on('value', (snapshot) => {
const social = snapshot.val();
if (social) {
const headerFb = document.getElementById('header-social-fb');
const headerYt = document.getElementById('header-social-yt');
const headerDeskFb = document.getElementById('header-desktop-social-fb');
const headerDeskYt = document.getElementById('header-desktop-social-yt');
const footerFb = document.getElementById('footer-social-fb');
const footerYt = document.getElementById('footer-social-yt');
if (social.facebook) {
headerFb.href = social.facebook;
headerFb.classList.remove('hidden');
headerDeskFb.href = social.facebook;
headerDeskFb.classList.remove('hidden');
footerFb.href = social.facebook;
footerFb.classList.remove('hidden');
} else {
headerFb.classList.add('hidden');
headerDeskFb.classList.add('hidden');
footerFb.classList.add('hidden');
}
if (social.youtube) {
headerYt.href = social.youtube;
headerYt.classList.remove('hidden');
headerDeskYt.href = social.youtube;
headerDeskYt.classList.remove('hidden');
footerYt.href = social.youtube;
footerYt.classList.remove('hidden');
} else {
headerYt.classList.add('hidden');
headerDeskYt.classList.add('hidden');
footerYt.classList.add('hidden');
}
}
});
function getResponsiveVideoPlayer(url) {
if (!url) return '<p style="color:white; padding:10px;">Babu bidiyo da aka ɗora</p>';
const youtubeRegex = /(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?)\/|.*[?&]v=)|youtu\.be\/)([^"&?\/\s]{11})/i;
const match = url.match(youtubeRegex);
if (match && match[1]) {
const videoId = match[1];
return `
<div style="position:relative; padding-bottom:56.25%; height:0; overflow:hidden; border-radius:8px;">
<iframe src="https://www.youtube.com/embed/${videoId}" 
style="position:absolute; top:0; left:0; width:100%; height:100%; border:0;" 
allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
allowfullscreen>
</iframe>
</div>`;
} else {
return `
<video controls playsinline preload="metadata" style="width:100%; max-height:450px; border-radius:8px; background:#000;">
<source src="${url}" type="video/mp4">
Wayarka ba ta goyon bayan wannan bidiyon.
</video>`;
}
}
db.ref('settings/videoUrl').on('value', (snapshot) => {
const url = snapshot.val();
const container = document.getElementById('video-container');
if (container) {
container.innerHTML = getResponsiveVideoPlayer(url);
}
// Update download button if it exists
const dlBtn = document.getElementById('video-download-btn');
if (dlBtn && url) {
dlBtn.href = url;
if (url.includes('youtube.com') || url.includes('youtu.be')) {
dlBtn.removeAttribute('download');
dlBtn.setAttribute('target', '_blank');
} else {
dlBtn.setAttribute('download', 'video.mp4');
dlBtn.removeAttribute('target');
}
}
});
db.ref('settings/ad').on('value', (snapshot) => {
const ad = snapshot.val();
if (ad) {
document.getElementById('dynamic-ad-title').textContent = ad.title || 'Dynamic Banner Ad';
document.getElementById('dynamic-ad-link').href = ad.link || '#';
if (ad.image) {
document.getElementById('dynamic-ad-image').src = ad.image;
}
}
});
db.ref('office_flyer/current').on('value', (snapshot) => {
const data = snapshot.val();
const flyerLink = document.getElementById('public-office-flyer-link');
const flyerImage = document.getElementById('public-office-flyer-image');
if (data && data.image) {
flyerLink.href = data.link || '#';
flyerImage.src = data.image;
flyerLink.classList.remove('hidden');
} else {
flyerLink.classList.add('hidden');
}
});
// Article View Logic
// Article View Logic
function shareArticle(title, text) {
if (navigator.share) {
navigator.share({
title: title,
text: text,
url: window.location.href
}).catch(console.error);
} else {
alert('Web Share API is not supported in your browser. Copy the URL to share.');
}
}

// FUNCTION DON TACE LOKACI (DATE FORMATTER)
function formatNewsDate(dateString) {
  if (!dateString) return "Just Now";
  
  const timestamp = !isNaN(Number(dateString)) ? Number(dateString) : dateString;
  const newsDate = new Date(timestamp);
  const now = new Date();
  const timeDifference = now - newsDate;
  
  // Idan labarin bai kai sa'a guda da duba shi ba
  const minutes = Math.floor(timeDifference / 60000);
  if (minutes < 60) {
    return minutes <= 1 ? "Just Now" : `${minutes} mins ago`;
  }
  
  // Idan bai kai kwana 1 ba
  const hours = Math.floor(minutes / 60);
  if (hours < 24) {
    return `${hours} hours ago`;
  }
  
  // Idan ya wuce kwana daya, zai nuna ainihin ranar (Misali: Jul 8, 2026)
  return newsDate.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric'
  });
}

function getYouTubeEmbedUrl(url) {
    if (!url) return '';
    let videoId = '';
    const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=))((\w|-){11})/);
    if (match && match[1]) {
        videoId = match[1];
    }
    return videoId ? `https://www.youtube.com/embed/${videoId}` : url;
}


function updateMetaTags(article) {
  document.title = `${article.title} | Alu TV`;
  
  const description = article.summary || '';
  const imageUrl = article.image || '/assets/placeholder.jpg';
  const url = `https://alutv.com/news-detail.html?id=${article.id}`;
  
  // Update or create description
  let metaDesc = document.querySelector('meta[name="description"]');
  if (!metaDesc) {
      metaDesc = document.createElement('meta');
      metaDesc.name = "description";
      document.head.appendChild(metaDesc);
  }
  metaDesc.content = description;

  // Function to update or create og tags
  const setMetaProperty = (property, content) => {
      let meta = document.querySelector(`meta[property="${property}"]`);
      if (!meta) {
          meta = document.createElement('meta');
          meta.setAttribute('property', property);
          document.head.appendChild(meta);
      }
      meta.content = content;
  };

  setMetaProperty('og:type', 'article');
  setMetaProperty('og:title', `${article.title} - Alu TV`);
  setMetaProperty('og:description', description);
  setMetaProperty('og:image', imageUrl);
  setMetaProperty('og:url', url);
  setMetaProperty('og:site_name', 'Alu TV Nigeria');

  // Function to update or create twitter tags
  const setMetaName = (name, content) => {
      let meta = document.querySelector(`meta[name="${name}"]`);
      if (!meta) {
          meta = document.createElement('meta');
          meta.setAttribute('name', name);
          document.head.appendChild(meta);
      }
      meta.content = content;
  };

  setMetaName('twitter:card', 'summary_large_image');
  setMetaName('twitter:title', article.title);
  setMetaName('twitter:description', description);
  setMetaName('twitter:image', imageUrl);
}

function openArticle(id) {
  const article = articles.find(a => a.id == id);
  if (!article) return;
  updateMetaTags(article);
  if (window.location.hash !== '#post-' + id) {
    history.pushState(null, null, '#post-' + id);
  }
  document.getElementById('homepage-grid').classList.add('hidden');
  const articleView = document.getElementById('single-article-view');
  articleView.classList.remove('hidden');
  
  const formattedDate = formatNewsDate(article.id);
  
  let mediaHTML = '';
  if (article.type === 'video' && article.videoUrl) {  
    const ytUrl = getYouTubeEmbedUrl(article.videoUrl);
    if (ytUrl !== article.videoUrl) {
        mediaHTML = `<div class="custom-video-wrapper w-full mb-8 bg-black rounded-lg overflow-hidden border-2 border-news-purple shadow-[0_0_15px_rgba(59,7,100,0.5)] aspect-video relative">
           <iframe src="${ytUrl}" frameborder="0" allowfullscreen class="absolute top-0 left-0 w-full h-full border-0"></iframe>
        </div>`;
    } else {
        mediaHTML = `<div class="custom-video-wrapper w-full mb-8 bg-black rounded-lg overflow-hidden border-2 border-news-purple shadow-[0_0_15px_rgba(59,7,100,0.5)] aspect-video">
          <video controls preload="metadata" poster="${article.image || 'placeholder.jpg'}" style="width:100%; height:100%; object-fit:cover; border-radius:8px; background:#000;">
            <source src="${article.videoUrl}" type="video/mp4">
            Your browser does not support the video tag.
          </video>
        </div>`;
    }
  } else if (article.type === 'audio' && article.audioUrl) {  
    mediaHTML = `<div class="custom-audio-container w-full mb-8 bg-[#f5f5f5] p-4 rounded-lg border-l-[4px] border-news-purple shadow-sm">
      <p class="text-gray-900 font-bold mb-2 text-[13px]">🎵 Saurari Labari (Audio):</p>
      <audio controls class="w-full h-[40px] mb-2">
        <source src="${article.audioUrl}" type="audio/mpeg">
        Your browser does not support the audio element.
      </audio>
      <div class="text-right mt-2">
        <a href="${article.audioUrl}" download="AluTv-${article.title.replace(/\s+/g, '-').toLowerCase()}.mp3" target="_blank" class="bg-news-purple text-white px-3 py-1.5 no-underline rounded text-xs inline-block font-bold hover:bg-purple-800 transition-colors">
          📥 Saukar da Audio (Direct Download)
        </a>
      </div>
    </div>`;
  } else {  
    if (article.image) {    
      mediaHTML += `<div class="w-full mb-8"><img src="${article.image}" alt="${article.title}" class="w-full h-auto max-h-[500px] object-cover rounded-lg shadow-sm" /></div>`;  
    }
  }
  
  let contentHTML = '';
  if (article.type === 'article' || !article.type) {
    
    let text = article.content || '<p>Content missing.</p>';
    
    // FUNCTION TO INSERT "SEE ALSO" LINKS USING ARTICLE TITLE (ENGLISH)
    text = text.replace(/\[(?:see-also|related):\s*([^\]]+)\]/g, (match, targetTitle) => {
       const cleanTargetTitle = targetTitle.trim().toLowerCase();
       const relatedNews = articles.find(item => 
          item.title && item.title.trim().toLowerCase() === cleanTargetTitle
       );
       if (relatedNews) {
          return `<div class="see-also-container" style="margin: 20px 0; padding: 12px; background: #f9f9f9; border-left: 4px solid #7b1fa2; border-radius: 4px;">
             <span style="font-size: 11px; font-weight: bold; color: #7b1fa2; text-transform: uppercase; display: block; margin-bottom: 4px;">See Also:</span>
             <a href="#post-${relatedNews.id}" class="see-also-link" style="color: #111; font-weight: bold; text-decoration: none; font-size: 15px; display: inline-block;" onclick="openArticle('${relatedNews.id}'); return false;">
                ${relatedNews.title} ➔
             </a>
          </div>`;
       }
       return '';
    });

    if (article.bodyImage) {
       const midpoint = Math.floor(text.length / 2);
       const brk = text.indexOf('</p>', midpoint);
       if (brk !== -1) {
         text = text.substring(0, brk + 4) + `<div class="w-full my-6"><img src="${article.bodyImage}" class="w-full h-auto object-cover rounded-lg shadow-sm" /></div>` + text.substring(brk + 4);
       } else {
         text += `<div class="w-full my-6"><img src="${article.bodyImage}" class="w-full h-auto object-cover rounded-lg shadow-sm" /></div>`;
       }
    }
    contentHTML = `<div class="text-base md:text-lg text-gray-800 leading-relaxed space-y-6">
      <p class="font-bold text-lg md:text-xl text-gray-900 border-l-4 border-news-purple pl-4 py-1">${article.subtitle || article.summary}</p>
      <div class="rich-content space-y-4 pt-4">${text}</div>
    </div>`;
  } else {
    contentHTML = `<div class="text-base md:text-lg text-gray-800 leading-relaxed space-y-6">
      <p class="font-bold text-lg md:text-xl text-gray-900 border-l-4 border-news-purple pl-4 py-1">${article.subtitle || article.summary}</p>
    </div>`;
  }
  
  articleView.innerHTML = `<article class="bg-white p-4 md:p-8 shadow-sm rounded-lg border border-gray-200 flex-1 w-full"><button onclick="navigate('Home', event)" class="text-news-purple hover:text-news-purple flex items-center gap-2 text-sm font-bold uppercase tracking-wider mb-6 transition-colors"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>Back</button><div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4"><h1 class="text-3xl md:text-4xl font-black text-gray-900 leading-tight tracking-tighter flex-1">${article.title}</h1><button onclick="shareArticle('${article.title.replace(/'/g, "\\'")}', '${(article.summary || '').replace(/'/g, "\\'")}')" class="bg-news-purple text-white px-4 py-2 rounded text-sm font-bold flex items-center justify-center gap-2 hover:bg-purple-800 transition-colors shrink-0"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>Share Story</button></div><div class="flex flex-wrap items-center gap-2 md:gap-3 text-xs md:text-sm text-gray-500 font-bold uppercase tracking-wide mb-6"><span class="bg-news-purple text-white px-2 py-1 rounded-sm">${article.category}</span><span class="hidden md:inline">&bull;</span><span>${formattedDate}</span><span class="hidden md:inline">&bull;</span><span>By Alu Tv News Desk</span></div>${mediaHTML}${contentHTML}</article>`;
  window.scrollTo({ top: 0, behavior: 'smooth' });
}


function updateTicker(articlesList) {
  const tickerElement = document.getElementById('breakingTicker');
  if (!tickerElement) return;
  
  let tickerHtml = '';
  
  if (window.customTickerText) {
     tickerHtml += `<span style="color: #ff3b3b; text-transform: uppercase;">• ${window.customTickerText}</span> &nbsp;&nbsp;&nbsp; `;
  }
  
  // Get latest 5 published articles
  const latestArticles = (articlesList || [])
    .filter(a => a.status === 'Publish')
    .slice(0, 5);
    
  if (latestArticles.length > 0) {
    tickerHtml += latestArticles.map(a => 
      `<span style="cursor:pointer;" onclick="openArticle('${a.id}')">• ${a.title}</span>`
    ).join(' &nbsp;&nbsp;&nbsp; ');
  } else if (!window.customTickerText) {
    tickerHtml = `<span>• No breaking news at this time.</span>`;
  }
  
  tickerElement.innerHTML = tickerHtml;
}

function renderArticles(category) {
  const container = document.getElementById('main-content');
  const bottomContainer = document.getElementById('home-bottom-content');
  
  if(container) container.innerHTML = '';
  if(bottomContainer) bottomContainer.innerHTML = '';
  
  let filtered = articles.filter(a => a.status === 'Publish');
  
  if (category !== 'Home') {
    filtered = filtered.filter(a => a.category === category);
  }
  
  if (filtered.length === 0) {
    if(container) container.innerHTML = '<div class="p-8 text-center text-gray-500 font-bold uppercase tracking-widest">No posts available in this section.</div>';
    if(bottomContainer) bottomContainer.classList.add('hidden');
    return;
  }

  const textArticles = filtered.filter(a => a.type === 'article' || !a.type);
  const videoArticles = filtered.filter(a => a.type === 'video');
  const audioArticles = filtered.filter(a => a.type === 'audio');
  
  let htmlContent = '';
  let bottomContent = '';

  if (category === 'Home') {
    bottomContent += `
      <section class="premium-showcase-section">
        <div class="section-header">
          <h2>ALU TV ORIGINALS</h2>
          <p>Exclusive Investigative Documentaries and In-depth Field Reporting</p>
        </div>
        
        <div class="cinematic-grid" id="documentaryGrid">
          <!-- Populated by renderOriginals() -->
        </div>
      </section>
    `;
  }
  
  // SECTION 1: LATEST TEXT ARTICLES
  if (textArticles.length > 0) {
    htmlContent += `<div class="mb-12"><h2 class="text-xl md:text-2xl font-black text-gray-900 border-l-4 border-news-purple pl-3 mb-6 tracking-tighter uppercase">${category === 'Home' ? 'Latest Articles' : category + ' Articles'}</h2>`;
    
    const feature = textArticles[0];
    const featureDate = formatNewsDate(feature.id);
    const featureMedia = feature.image ? `<img src="${feature.image}" alt="${feature.title}" class="w-full h-[300px] object-cover rounded-sm shadow-sm hover:opacity-90 transition-opacity" />` : `<div class="w-full h-[300px] bg-gray-200 rounded-sm shadow-sm flex items-center justify-center"><span class="text-gray-400">No Image</span></div>`;
    
    htmlContent += `<article onclick="openArticle('${feature.id}')" class="cursor-pointer group mb-6">
      ${featureMedia}
      <div class="mt-4">
         <span class="text-news-purple text-[10px] font-bold px-2 py-1 uppercase bg-purple-100 rounded-sm mb-2 inline-block tracking-widest">${feature.category}</span>
         <h1 class="text-2xl lg:text-3xl font-bold text-gray-900 leading-tight mb-2 group-hover:text-purple-800 transition-colors">${feature.title}</h1>
         <p class="text-gray-600 text-sm max-w-3xl">${feature.subtitle || feature.summary}</p>
         <span class="text-[11px] text-gray-500 font-medium block mt-2">${featureDate}</span>
      </div>
    </article>`;
    
    const sub = textArticles.slice(1);
    if (sub.length > 0) {
      htmlContent += `<div class="flex flex-col">`;
      htmlContent += sub.map(article => {
         const artDate = formatNewsDate(article.id);
         const img = article.image ? `<img src="${article.image}" alt="${article.title}" class="w-[100px] h-[75px] object-cover rounded-sm group-hover:opacity-90 transition-opacity flex-shrink-0" />` : `<div class="w-[100px] h-[75px] bg-gray-200 rounded-sm flex-shrink-0"></div>`;
         return `<article onclick="openArticle('${article.id}')" class="flex items-center gap-4 border-b border-gray-200 py-4 cursor-pointer group last:border-0">
            ${img}
            <div class="flex flex-col justify-center flex-1">
               <span class="text-[10px] text-news-purple font-bold uppercase tracking-widest mb-1">${article.category}</span>
               <h3 class="font-bold text-base leading-tight mb-1 group-hover:text-purple-700 transition-colors line-clamp-2 text-gray-900">${article.title}</h3>
               <span class="text-[11px] text-gray-500 font-medium">${artDate}</span>
            </div>
         </article>`;
      }).join('');
      htmlContent += `</div>`;
    }
    htmlContent += `</div>`;
  }
  
  // SECTION 2: LATEST VIDEOS
  if (videoArticles.length > 0) {
     let vidContent = `<div class="mb-12"><h2 class="text-xl md:text-2xl font-black text-gray-900 border-l-4 border-news-purple pl-3 mb-6 tracking-tighter uppercase">${category === 'Home' ? 'Latest Videos' : category + ' Videos'}</h2>`;
     vidContent += `<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">`;
     vidContent += videoArticles.map(article => {
        const artDate = formatNewsDate(article.id);
        const embedUrl = getYouTubeEmbedUrl(article.videoUrl);
        let playerHtml = '';
        if (embedUrl !== article.videoUrl) {
            playerHtml = `<iframe src="${embedUrl}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen class="absolute inset-0 w-full h-full border-0"></iframe>`;
        } else {
            playerHtml = `<video controls preload="metadata" poster="${article.image || 'placeholder.jpg'}" style="width:100%; height:100%; object-fit:cover; border-radius:8px; background:#000;" class="absolute inset-0 w-full h-full object-cover">
              <source src="${article.videoUrl}" type="video/mp4">
            </video>`;
        }
        return `<article class="bg-black rounded-sm overflow-hidden shadow-md flex flex-col">
           <div class="relative w-full aspect-video">
              ${playerHtml}
           </div>
           <div class="p-4 cursor-pointer flex-1" onclick="openArticle('${article.id}')">
              <span class="text-[10px] text-purple-400 font-bold uppercase tracking-widest mb-1 inline-block">${article.category}</span>
              <h3 class="font-bold text-white text-base md:text-lg leading-tight hover:text-gray-300 transition-colors line-clamp-2 mb-2">${article.title}</h3>
              <span class="text-[11px] text-gray-400 font-medium">${artDate}</span>
           </div>
        </article>`;
     }).join('');
     vidContent += `</div></div>`;
     
     bottomContent += vidContent;
  }
  
  // SECTION 3: LATEST AUDIOS
  if (audioArticles.length > 0) {
     htmlContent += `<div class="mb-12"><h2 class="text-xl md:text-2xl font-black text-gray-900 border-l-4 border-news-purple pl-3 mb-6 tracking-tighter uppercase">${category === 'Home' ? 'Latest Audios' : category + ' Audios'}</h2>`;
     htmlContent += `<div class="grid grid-cols-1 lg:grid-cols-2 gap-4">`;
     htmlContent += audioArticles.map(article => {
         const artDate = formatNewsDate(article.id);
         let audioContent = `<div class="custom-audio-container w-full mt-4 bg-[#f5f5f5] p-3 rounded-lg border-l-[4px] border-news-purple shadow-sm" onclick="event.stopPropagation();">
           <p class="text-gray-900 font-bold text-sm mb-2 text-[13px]">🎵 Saurari Labari (Audio):</p>
           <audio controls class="w-full mb-2 h-[40px]">
             <source src="${article.audioUrl}" type="audio/mpeg">
           </audio>
           <div class="text-right mt-1">
             <a href="${article.audioUrl}" download="AluTv-${article.title.replace(/s+/g, '-').toLowerCase()}.mp3" target="_blank" class="bg-news-purple text-white px-2 py-1.5 no-underline rounded text-[11px] inline-block font-bold hover:bg-purple-800 transition-colors">
               📥 Saukar da Audio (Direct Download)
             </a>
           </div>
         </div>`;
         return `<article class="bg-news-purple text-white p-5 rounded-sm shadow-md flex flex-col gap-4 border border-purple-900">
            <div class="cursor-pointer" onclick="openArticle('${article.id}')">
               <span class="text-[10px] text-purple-300 font-bold uppercase tracking-widest mb-1 inline-block">${article.category}</span>
               <h3 class="font-bold text-lg md:text-xl leading-tight hover:text-purple-200 transition-colors line-clamp-2 mb-2">${article.title}</h3>
               <span class="text-[11px] text-purple-200 font-medium">${artDate}</span>
            </div>
            ${audioContent}
         </article>`;
     }).join('');
     htmlContent += `</div></div>`;
  }
  
  if(container) container.innerHTML = htmlContent;
  if(bottomContainer) {
    bottomContainer.innerHTML = bottomContent;
    if(bottomContent.trim() !== '') {
       bottomContainer.classList.remove('hidden');
    } else {
       bottomContainer.classList.add('hidden');
    }
  }
  
  if(category === 'Home' && typeof renderOriginals === 'function') {
      renderOriginals();
  }
}
function navigate(category, event) {
if (event) {
event.preventDefault();
}
// Clear hash if navigating back to home or other categories
if (window.location.hash) {
history.pushState(null, null, window.location.pathname + window.location.search);
}
// Update Active Nav Link Styling
const links = document.querySelectorAll('.nav-link');
links.forEach(link => {
if (link.dataset.target === category) {
link.classList.remove('lg:border-transparent');
link.classList.add('border-white', 'lg:border-white');
} else {
link.classList.remove('border-white', 'lg:border-white');
link.classList.add('lg:border-transparent');
}
});
// Show homepage grid, hide single article
document.getElementById('homepage-grid').classList.remove('hidden');
document.getElementById('single-article-view').classList.add('hidden');
// Render new category content
renderArticles(category);
}
// 4. Admin Dashboard Logic
// Post Management Logic
function renderAdminTable() {
const tbody = document.getElementById('admin-post-table-body');
tbody.innerHTML = articles.map(art => `
<tr class="hover:bg-gray-50 border-b last:border-0">
<td class="p-3 font-semibold text-gray-800">${art.title}</td>
<td class="p-3 text-gray-600">${art.category}</td>
<td class="p-3">
<span class="px-2 py-1 rounded text-[10px] font-bold uppercase tracking-wider ${art.status === 'Draft' ? 'bg-yellow-100 text-yellow-800' : 'bg-green-100 text-green-800'}">${art.status}</span>
</td>
<td class="p-3 text-right space-x-3">
<button onclick="editPost('${art.id}')" class="text-blue-600 hover:text-blue-800 font-bold text-xs uppercase tracking-wider">Edit</button>
${currentUserRole === 'superadmin' ? `<button onclick="deletePost('${art.id}')" class="text-news-purple hover:text-purple-800 font-bold text-xs uppercase tracking-wider">Delete</button>` : ''}
</td>
</tr>
`).join('');
}
function editPost(id) {
const article = articles.find(a => a.id == id);
if (!article) return;
document.getElementById('admin-art-id').value = article.id;
document.getElementById('admin-art-type').value = article.type || 'article';
window.togglePostType();
document.getElementById('admin-art-title').value = article.title;
if(document.getElementById('admin-art-subtitle')) document.getElementById('admin-art-subtitle').value = article.subtitle || '';
document.getElementById('admin-art-category').value = article.category;
document.getElementById('admin-art-status').value = article.status;
document.getElementById('admin-art-content').innerHTML = article.content || '';
if(document.getElementById('adminVideoUrl')) document.getElementById('adminVideoUrl').value = article.videoUrl || '';
if(document.getElementById('adminAudioUrl')) document.getElementById('adminAudioUrl').value = article.audioUrl || '';
document.getElementById('admin-art-form-title').innerText = 'Edit Post';
document.getElementById('admin-art-submit-btn').innerText = 'Update Post';
document.getElementById('admin-art-cancel-btn').classList.remove('hidden');
document.getElementById('admin-dashboard').scrollIntoView({ behavior: 'smooth' });
}
function deletePost(id) {
if (!db) return alert('Please configure Firebase first!');
if (confirm('Are you sure you want to delete this post?')) {
db.ref('articles/' + id).remove()
.then(() => {
// Reset form if we were editing this deleted post
if (document.getElementById('admin-art-id').value == id) {
resetArticleForm();
}
alert('Article deleted.');
})
.catch(err => alert('Error deleting article: ' + err));
}
}
function resetArticleForm() {
document.getElementById('admin-art-id').value = '';
document.getElementById('admin-art-type').value = 'article';
window.togglePostType();
document.getElementById('admin-art-title').value = '';
document.getElementById('admin-art-subtitle').value = '';
document.getElementById('admin-art-category').value = 'Politics';
document.getElementById('admin-art-status').value = 'Publish';
document.getElementById('admin-art-content').innerHTML = '';
document.getElementById('admin-art-image').value = '';
document.getElementById('admin-art-body-image').value = '';
document.getElementById('adminVideoUrl').value = '';
document.getElementById('adminAudioUrl').value = '';
document.getElementById('admin-art-form-title').innerText = 'Add New Article';
document.getElementById('admin-art-submit-btn').innerText = 'Publish Post';
document.getElementById('admin-art-cancel-btn').classList.add('hidden');
}
// Handle Content Updates
window.togglePostType = function() {
  const type = document.getElementById('admin-art-type').value;
  document.getElementById('admin-field-subtitle').classList.toggle('hidden', type !== 'article');
  document.getElementById('admin-field-content').classList.toggle('hidden', type !== 'article');
  document.getElementById('admin-field-top-image').classList.toggle('hidden', type !== 'article');
  document.getElementById('admin-field-body-image').classList.toggle('hidden', type !== 'article');
  document.getElementById('admin-field-video').classList.toggle('hidden', type !== 'video');
  document.getElementById('admin-field-audio').classList.toggle('hidden', type !== 'audio');
};

async function handleArticleSubmit(e) {
  e.preventDefault();
  const id = document.getElementById('admin-art-id').value;
  const type = document.getElementById('admin-art-type').value;
  const title = document.getElementById('admin-art-title').value;
  const subtitle = document.getElementById('admin-art-subtitle').value;
  const category = document.getElementById('admin-art-category').value;
  const status = document.getElementById('admin-art-status').value;
  const content = document.getElementById('admin-art-content').innerHTML;

  // Extract a summary
  const tempDiv = document.createElement('div');
  tempDiv.innerHTML = content;
  const plainText = tempDiv.textContent || tempDiv.innerText || "";
  const summary = plainText.substring(0, 150) + (plainText.length > 150 ? '...' : '');

  const submitBtn = document.getElementById('admin-art-submit-btn');
  const originalBtnText = submitBtn.innerText;
  submitBtn.innerText = 'Processing...';
  submitBtn.disabled = true;

  try {
    let videoUrl = '';
    let audioUrl = '';
    let imageStr = '';
    let bodyImageStr = '';

    if (id) {
      const existingArticle = articles.find(a => a.id == id);
      if (existingArticle) {
        videoUrl = existingArticle.videoUrl || '';
        audioUrl = existingArticle.audioUrl || '';
        imageStr = existingArticle.image || '';
        bodyImageStr = existingArticle.bodyImage || '';
      }
    }

    if (type === 'video') {
      let vUrl = document.getElementById('adminVideoUrl').value;
      if (vUrl) {
        if (vUrl.includes('drive.google.com')) {
          const match = vUrl.match(/\/d\/([a-zA-Z0-9_-]+)/);
          if (match && match[1]) {
            vUrl = `https://docs.google.com/uc?export=download&id=${match[1]}`;
          }
        }
        videoUrl = vUrl;
      } else if (!id) {
        throw new Error("Video URL is required for Video posts.");
      }
    }

    if (type === 'audio') {
      let aUrl = document.getElementById('adminAudioUrl').value;
      if (aUrl) {
        if (aUrl.includes('drive.google.com')) {
          const match = aUrl.match(/\/d\/([a-zA-Z0-9_-]+)/);
          if (match && match[1]) {
            aUrl = `https://docs.google.com/uc?export=download&id=${match[1]}`;
          }
        }
        audioUrl = aUrl;
      } else if (!id) {
        throw new Error("Audio URL is required for Audio posts.");
      }
    }

    if (type === 'article') {
      const fileInput = document.getElementById('admin-art-image');
      const imageFile = fileInput.files[0];
      if (imageFile) {
        imageStr = await new Promise((resolve) => {
          const reader = new FileReader();
          reader.onload = (e) => resolve(e.target.result);
          reader.readAsDataURL(imageFile);
        });
      } else if (!id) {
        throw new Error("Top cover image is required for articles.");
      }

      const bodyFileInput = document.getElementById('admin-art-body-image');
      const bodyImageFile = bodyFileInput.files[0];
      if (bodyImageFile) {
        bodyImageStr = await new Promise((resolve) => {
          const reader = new FileReader();
          reader.onload = (e) => resolve(e.target.result);
          reader.readAsDataURL(bodyImageFile);
        });
      }
    }

    saveArticleData(id, type, title, subtitle, category, status, content, summary, imageStr, bodyImageStr, videoUrl, audioUrl);
    submitBtn.innerText = originalBtnText;
    submitBtn.disabled = false;
  } catch (err) {
    console.error("Upload error:", err);
    alert('Error: ' + err.message);
    submitBtn.innerText = originalBtnText;
    submitBtn.disabled = false;
  }
}

function saveArticleData(id, type, title, subtitle, category, status, content, summary, image, bodyImage, videoUrl, audioUrl) {
  if (!db) return alert('Please configure Firebase first!');
  const data = { type, title, subtitle, category, status, content, summary, image, bodyImage, videoUrl, audioUrl };
  
  if (id) {
    db.ref('articles/' + id).update(data)
      .then(() => {
        alert('Post updated successfully!');
        resetArticleForm();
      })
      .catch(err => alert("Error updating post: " + err));
  } else {
    const newId = Date.now().toString();
    data.id = newId;
    db.ref('articles/' + newId).set(data)
      .then(() => {
        alert('Post published successfully!');
        resetArticleForm();
      })
      .catch(err => alert("Error publishing post: " + err));
  }
}
function handleSocialLinksUpdate(e) {
e.preventDefault();
if (!db) return alert('Please configure Firebase first!');
const facebook = document.getElementById('admin-facebook-url').value;
const youtube = document.getElementById('admin-youtube-url').value;
db.ref('settings/social').set({ facebook, youtube })
.then(() => {
alert('Social media links updated successfully!');
})
.catch(err => alert('Error updating social links: ' + err));
}
function handleVideoUpdate(e) {
e.preventDefault();
if (!db) return alert('Please configure Firebase first!');
const ytInput = document.getElementById('admin-video-youtube').value;
const fileInput = document.getElementById('admin-video-url');
const file = fileInput.files[0];
if (ytInput) {
db.ref('settings/videoUrl').set(ytInput)
.then(() => {
e.target.reset();
alert('Video updated to YouTube successfully!');
})
.catch(err => alert('Error updating video: ' + err));
} else if (file) {
const reader = new FileReader();
reader.onload = function(event) {
const url = event.target.result;
db.ref('settings/videoUrl').set(url)
.then(() => {
e.target.reset();
alert('Video file updated successfully!');
})
.catch(err => alert('Error updating video: ' + err));
};
reader.readAsDataURL(file);
} else {
alert("Please provide a YouTube URL or upload a video file.");
}
}

function handleAdUpdate(e) {
e.preventDefault();
if (!db) return alert('Please configure Firebase first!');
const title = document.getElementById('admin-ad-title-input').value;
const link = document.getElementById('admin-ad-link-input').value;
const fileInput = document.getElementById('admin-ad-image-input');
const file = fileInput.files[0];
if (file) {
const reader = new FileReader();
reader.onload = function(event) {
const image = event.target.result;
db.ref('settings/ad').set({ title, link, image })
.then(() => {
e.target.reset();
alert('Ad updated successfully!');
})
.catch(err => alert('Error updating ad: ' + err));
};
reader.readAsDataURL(file);
}
}

async function handleOriginalSubmit(e) {
  e.preventDefault();
  const submitBtn = e.target.querySelector('button[type="submit"]');
  submitBtn.disabled = true;
  submitBtn.textContent = 'Publishing...';
  
  try {
    const title = document.getElementById('admin-orig-title').value;
    const badge = document.getElementById('admin-orig-badge').value;
    const videoUrl = document.getElementById('admin-orig-video-url').value;
    const posterFile = document.getElementById('admin-orig-poster').files[0];
    
    let posterUrl = '';
    if (posterFile) {
        const storageRef = firebase.storage().ref('originals/' + Date.now() + '_' + posterFile.name);
        const snapshot = await storageRef.put(posterFile);
        posterUrl = await snapshot.ref.getDownloadURL();
    }
    
    // We create a special post object to track it
    const id = Date.now();
    const newOriginal = {
      id,
      type: 'original',
      title,
      badge,
      posterUrl,
      videoUrl,
      timestamp: firebase.database.ServerValue.TIMESTAMP
    };
    
    await db.ref('originals/' + id).set(newOriginal);
    
    alert('Alu TV Original Published!');
    e.target.reset();
  } catch (error) {
    console.error('Error publishing original:', error);
    alert('Failed to publish original: ' + error.message);
  } finally {
    submitBtn.disabled = false;
    submitBtn.textContent = 'Publish Original';
  }
}

async function handleTickerSave(btn) {
  btn.disabled = true;
  btn.textContent = 'Saving...';
  try {
    const tickerText = document.getElementById('admin-ticker-text').value;
    await db.ref('settings/ticker').set(tickerText);
    alert('Ticker Updated Successfully!');
  } catch (error) {
    console.error('Error updating ticker:', error);
    alert('Failed to update ticker: ' + error.message);
  } finally {
    btn.disabled = false;
    btn.textContent = 'Save / Update';
  }
}

async function handleTickerClear(btn) {
  btn.disabled = true;
  btn.textContent = 'Clearing...';
  try {
    await db.ref('settings/ticker').set(null);
    document.getElementById('admin-ticker-text').value = '';
    alert('Ticker Cleared Successfully!');
  } catch (error) {
    console.error('Error clearing ticker:', error);
    alert('Failed to clear ticker: ' + error.message);
  } finally {
    btn.disabled = false;
    btn.textContent = 'Clear / Delete';
  }
}

function handleOfficeFlyerUpdate(e) {
e.preventDefault();
if (currentUserRole !== 'superadmin' && currentUserRole !== 'admin') {
alert('Not authorized');
return;
}
const link = document.getElementById('admin-flyer-link-input').value;
const fileInput = document.getElementById('admin-flyer-image-input');
const file = fileInput.files[0];
if (file) {
const reader = new FileReader();
reader.onload = function(event) {
const img = new Image();
img.onload = function() {
const canvas = document.createElement('canvas');
let width = img.width;
let height = img.height;
const maxWidth = 1200;
const maxHeight = 1200;
if (width > height) {
if (width > maxWidth) {
height = Math.round(height *= maxWidth / width);
width = maxWidth;
}
} else {
if (height > maxHeight) {
width = Math.round(width *= maxHeight / height);
height = maxHeight;
}
}
canvas.width = width;
canvas.height = height;
const ctx = canvas.getContext('2d');
ctx.drawImage(img, 0, 0, width, height);
const compressedBase64 = canvas.toDataURL('image/jpeg', 0.8);
db.ref('office_flyer/current').set({ link, image: compressedBase64 })
.then(() => {
e.target.reset();
alert('Office Flyer updated successfully!');
})
.catch(err => alert("Error updating flyer: " + err));
};
img.src = event.target.result;
};
reader.readAsDataURL(file);
}
}
function handleCreateUser(e) {
e.preventDefault();
if (currentUserRole !== 'superadmin') return;
const name = document.getElementById('new-user-name').value;
const email = document.getElementById('new-user-email').value;
const password = document.getElementById('new-user-password').value;
const role = document.getElementById('new-user-role').value;
// Check if email exists
if (allUsers.find(u => u.email === email)) {
alert('User with this email already exists!');
return;
}
db.ref('users').push({ name, email, password, role })
.then(() => {
alert('User created successfully!');
e.target.reset();
})
.catch(err => alert("Error creating user: " + err));
}
function deleteUser(id) {
if (currentUserRole !== 'superadmin') return;
if (confirm('Are you sure you want to delete this user?')) {
db.ref('users/' + id).remove()
.then(() => alert('User deleted.'))
.catch(err => alert('Error deleting user: ' + err));
}
}
function renderUsersTable() {
const tbody = document.getElementById('admin-users-table-body');
if (!tbody) return;
tbody.innerHTML = allUsers.map(u => `
<tr class="hover:bg-gray-50 transition-colors">
<td class="p-3">${u.name || '-'}</td>
<td class="p-3 font-bold">${u.email}</td>
<td class="p-3 uppercase tracking-wider text-xs">${u.role}</td>
<td class="p-3 text-right space-x-3">
${u.role !== 'superadmin' ? `<button onclick="deleteUser('${u.id}')" class="text-news-purple hover:text-purple-800 font-bold text-xs uppercase tracking-wider">Delete</button>` : '<span class="text-xs text-gray-400">Cannot Delete</span>'}
</td>
</tr>
`).join('');
}
function openLoginModal() {
document.getElementById('login-modal').classList.remove('hidden');
}
function closeLoginModal() {
document.getElementById('login-modal').classList.add('hidden');
document.getElementById('login-error').classList.add('hidden');
}
function handleLoginSubmit(e) {
e.preventDefault();
const userEmail = document.getElementById('login-username').value;
const pass = document.getElementById('login-password').value;
// Temporary master password bypass for recovery
if (userEmail === "admin@alutv.com" && pass === "AluTv2026@") {
currentUserRole = 'superadmin';
closeLoginModal();
applyRoleUI('superadmin');
e.target.reset();
alert('Logged in via Master Account successfully! Proceeding to Dashboard.');
return;
}
db.ref('users').once('value')
.then(snapshot => {
const users = snapshot.val();
if (!users) {
// First time login -> Register Super Admin
const newSuperAdmin = { name: 'Super Admin', email: userEmail, password: pass, role: 'superadmin' };
db.ref('users').push(newSuperAdmin).then(() => {
currentUserRole = 'superadmin';
closeLoginModal();
applyRoleUI('superadmin');
e.target.reset();
alert('Super Admin registered successfully! Proceeding to Dashboard.');
});
} else {
// Check credentials
let loggedInRole = null;
Object.values(users).forEach(u => {
if (u.email === userEmail && u.password === pass) {
loggedInRole = u.role;
}
});
if (loggedInRole) {
currentUserRole = loggedInRole;
closeLoginModal();
applyRoleUI(loggedInRole);
e.target.reset();
} else {
document.getElementById('login-error').innerText = "Invalid credentials";
document.getElementById('login-error').classList.remove('hidden');
}
}
})
.catch(err => {
console.error("Login error: ", err);
document.getElementById('login-error').innerText = "Database connection error.";
document.getElementById('login-error').classList.remove('hidden');
});
}
function logoutAdmin() {
currentUserRole = null;
document.getElementById('admin-dashboard').classList.add('hidden');
alert('Logged out successfully.');
}
function applyRoleUI(role) {
document.getElementById('admin-dashboard').classList.remove('hidden');
document.getElementById('admin-dashboard').scrollIntoView({ behavior: 'smooth' });
document.getElementById('admin-role-display').innerText = role;
const mediaConfig = document.getElementById('admin-media-config');
const postManagement = document.getElementById('admin-post-management');
const statusDropdown = document.getElementById('admin-art-status');
const manageUsers = document.getElementById('admin-manage-users');
// Reset visibility
mediaConfig.classList.remove('hidden');
postManagement.classList.remove('hidden');
manageUsers.classList.add('hidden');
statusDropdown.innerHTML = '<option value="Publish">Publish</option><option value="Draft">Draft</option>';
if (role === 'superadmin') {
manageUsers.classList.remove('hidden');
renderUsersTable();
} else if (role === 'editor') {
mediaConfig.classList.add('hidden');
} else if (role === 'reporter') {
mediaConfig.classList.add('hidden');
postManagement.classList.add('hidden');
statusDropdown.innerHTML = '<option value="Draft">Draft</option>';
}
renderAdminTable(); // Re-render table to show/hide delete buttons
}

function initializePushNotifications() {
  if (!("Notification" in window)) {
    console.log("This browser does not support desktop notification");
    return;
  }
  
  if (Notification.permission !== "granted" && Notification.permission !== "denied") {
    Notification.requestPermission().then((permission) => {
      if (permission === "granted") {
        console.log("Push notification permission granted successfully.");
      }
    });
  }
}

initializePushNotifications();
// Initialize the homepage on load
renderArticles('Home');
renderAdminTable();
// Handle browser back/forward buttons
window.addEventListener('hashchange', () => {
if (window.location.hash.startsWith('#post-')) {
const postId = window.location.hash.replace('#post-', '');
if (articles.length > 0) openArticle(postId);
} else if (window.location.hash === '' || window.location.hash === '#') {
const activeNav = document.querySelector('.nav-link.border-white');
const currentCategory = activeNav ? activeNav.dataset.target : 'Home';
// Use a simpler approach to restore grid without calling navigate
document.getElementById('homepage-grid').classList.remove('hidden');
document.getElementById('single-article-view').classList.add('hidden');
renderArticles(currentCategory);
}
});
</script>
</body>
</html>
